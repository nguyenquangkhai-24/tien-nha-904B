# Biến môi trường Backend API URL cho Frontend Next.js

# Môi trường Local (Mặc định):
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Môi trường Production trên Vercel:
# Thay URL bên dưới bằng domain Backend đã deploy trên Render.com
# Ví dụ: NEXT_PUBLIC_API_URL=https://tien-nha-904b-backend.onrender.com/api
